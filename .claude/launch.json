{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bodyweight-ladders",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "tools/serve.ps1",
        "-Port",
        "8123"
      ],
      "port": 8123
    },
    {
      "name": "bodyweight-ladders-mac",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8124", "--bind", "127.0.0.1"],
      "port": 8124
    }
  ]
}
